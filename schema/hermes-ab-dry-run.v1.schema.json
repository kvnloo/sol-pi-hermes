{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoL-Pi factorial benchmark dry-run report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "live_execution_enabled", "usage_source", "benchmark_target", "noninferiority", "jobs", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "dry_run"},
    "live_execution_enabled": {"const": false},
    "usage_source": {"const": "fake"},
    "benchmark_target": {"type": "string", "minLength": 1},
    "noninferiority": {
      "const": {
        "primary_contrast": ["both", "base"],
        "margin_percentage_points": -3,
        "confidence_level": 0.95,
        "interval_side": "one_sided_lower",
        "resampling_unit": "task",
        "decision": null,
        "lower_bound_percentage_points": null
      }
    },
    "jobs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/job"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "observation_pack", "action_fusion", "both"],
      "properties": {
        "base": {"$ref": "#/$defs/summary"},
        "observation_pack": {"$ref": "#/$defs/summary"},
        "action_fusion": {"$ref": "#/$defs/summary"},
        "both": {"$ref": "#/$defs/summary"}
      }
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "positive": {"type": "integer", "minimum": 1},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "cache_read_tokens", "cache_write_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/count"},
        "cache_read_tokens": {"$ref": "#/$defs/count"},
        "cache_write_tokens": {"$ref": "#/$defs/count"},
        "output_tokens": {"$ref": "#/$defs/count"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_index", "status", "usage"],
      "properties": {
        "request_index": {"$ref": "#/$defs/positive"},
        "status": {"const": "completed"},
        "usage": {"$ref": "#/$defs/usage"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "observationPack", "actionFusion", "evidencePreservingReducer", "onlineContextCompact"],
      "properties": {
        "version": {"const": 1},
        "observationPack": {"type": "boolean"},
        "actionFusion": {"type": "boolean"},
        "evidencePreservingReducer": {"const": false},
        "onlineContextCompact": {"const": false}
      }
    },
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "replicate", "arm", "execution_order", "seed", "argv_preview", "policy", "metric_source", "passed", "wall_ms", "user_turns", "model_response_turns", "requests"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^synthetic/"},
        "replicate": {"$ref": "#/$defs/positive"},
        "arm": {"enum": ["base", "observation_pack", "action_fusion", "both"]},
        "execution_order": {"type": "integer", "minimum": 1, "maximum": 4},
        "seed": {"$ref": "#/$defs/count"},
        "argv_preview": {"type": "array", "items": {"type": "string"}, "minItems": 4},
        "policy": {"$ref": "#/$defs/policy"},
        "metric_source": {"const": "fake"},
        "passed": {"type": "boolean"},
        "wall_ms": {"$ref": "#/$defs/positive"},
        "user_turns": {"const": 1},
        "model_response_turns": {"$ref": "#/$defs/positive"},
        "requests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/request"}}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["jobs", "passed", "pass_rate"],
      "properties": {
        "jobs": {"$ref": "#/$defs/positive"},
        "passed": {"$ref": "#/$defs/count"},
        "pass_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
